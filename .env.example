# Copy to .env and fill in real values. Never commit .env.
BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
NESHAN_API_KEY=
ADMIN_ID=
BALE_WALLET_TOKEN=

# Subscription (Toman)
SUB_MONTHLY_TOMAN=1200000
SUB_YEARLY_TOMAN=10000000
SUB_MONTHLY_DAYS=30
SUB_YEARLY_DAYS=365
TRIAL_CREDITS=2

# Utilities subscription (Toman) — damages/mahrieh, court fee, stamp, file tools
UTIL_SUB_MONTHLY_TOMAN=800000
UTIL_SUB_YEARLY_TOMAN=8000000
UTIL_FREE_PER_TOOL=1

MAX_CONCURRENT_QUERIES=10
# Per-user rate limit (messages / button clicks per window seconds; 0 = off; admin exempt)
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_CALLBACKS=30
RATE_LIMIT_WINDOW=60
EXECUTOR_MAX_WORKERS=20
# DATA_DIR=./data
# DB_PATH=./data/bot.sqlite3

BOT_USERNAME=Regionalvalue_bot
RENEW_REMIND_DAYS=3
RENEW_CHECK_INTERVAL=3600
HISTORY_PAGE_SIZE=10
BATCH_MAX_ITEMS=15
# SUBS_EXCEL_PATH=./data/subscriptions.xlsx

# Daily backup to admin (Tehran hour) and local copies kept
BACKUP_HOUR=3
BACKUP_KEEP=7
# Password for the backup zip (AES-256, open with 7-Zip/WinRAR). Strongly recommended:
# backups contain national IDs. Requires: pip install pyzipper
BACKUP_PASSWORD=
# Tax system outage detection
TAX_DOWN_THRESHOLD=3
TAX_PROBE_INTERVAL=300
# Trial follow-up (days after trial, personal discount %; 0 = no code)
TRIAL_FOLLOWUP_DAYS=3
TRIAL_FOLLOWUP_DISCOUNT=10
TRIAL_FOLLOWUP_CODE_DAYS=7
# Unusual usage alert (queries / provinces per 24h)
USAGE_ALERT_DAILY=50
USAGE_ALERT_PROVINCES=5
BROADCAST_DELAY=0.07
# Map image in regional value PDF (Neshan static map). Separate key only if your main key lacks it.
NESHAN_STATIC_MAP=1
# NESHAN_STATIC_MAP_KEY=
# Nearest valued block search when the chosen point has no regional value (seconds / parallel probes)
NEAREST_SEARCH_SECONDS=100
NEAREST_SEARCH_WORKERS=4
